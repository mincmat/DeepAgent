{
  "manifest_version": 3,
  "name": "DeepAgent",
  "version": "1.0.0",
  "description": "Connect DeepSeek web chat with local terminal",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["*://chat.deepseek.com/*", "http://localhost:8765/*"],
  "content_scripts": [
    {
      "matches": ["*://chat.deepseek.com/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
