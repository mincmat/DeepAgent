{
  "manifest_version": 3,
  "name": "DeepAgent — macOS Edition",
  "version": "1.0.0",
  "description": "Connect DeepSeek web chat with local macOS terminal",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"]
    }
  ]
}
